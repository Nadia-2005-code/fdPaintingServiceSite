---
import { siteInfo } from '../data/siteInfo';

interface Props {
  title?: string;
  text?: string;
}

const { 
  title = "HAVE A PROJECT IN MIND?", 
  text = "All quotes are completely free, clear, and fixed for 14 days with zero obligation." 
} = Astro.props;

---

<section class="cta-banner">
  <div class="container cta-inner">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="cta-actions">
      {siteInfo?.phone && (
        <a href={`tel:${siteInfo.phoneRaw}`} class="btn btn-call">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Call Now: {siteInfo.phone}</span>
        </a>
      )}
        <a href="/contact" class="btn btn-email">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Request a Quote Online</span>
      </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background-color: var(--surface, #ffffff);
    padding: 3.5rem 0 2.5rem;
    border-top: 1px solid var(--border, #e2e8f0);
    text-align: center;
  }


  .cta-inner h2 {
    font-family: var(--font-heading, inherit);
    font-size: 2.15rem;
    color: var(--dark, #12151a);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
    line-height: 1.15;
    font-weight: 800;
  }

  .cta-inner p {
    font-size: 1.05rem;
    color: var(--text-muted, #556275);
    margin: 0 0 1.75rem;
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
      gap: 1.25rem;
    }
  }

  .btn-call {
    background-color: var(--primary);
    border: 3px solid var(--primary);
    color: #ffffff !important;
  }

  .btn-call svg {
    flex-shrink: 0;
  }

  .btn-call:hover {
    background-color: var(--primary-dark, #1c4a85);
    border-color: var(--primary-dark, #1c4a85);
    transform: translateY(-1px);
  }

  .btn-email {
    background-color: var(--primary);
    border: 3px solid var(--primary);
    color: #ffffff !important;
  }
  .btn-email svg {
    flex-shrink: 0;
  }

  .btn-email:hover {
    background-color: #2b303a;
    border-color: #2b303a;
    transform: translateY(-1px);
  }
</style>
