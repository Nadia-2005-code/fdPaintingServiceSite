---
import { siteInfo } from '../data/siteInfo';
---

<footer class="site-footer">
  <div class="brush-edge-top" aria-hidden="true">
    <svg viewBox="0 0 1200 30" preserveAspectRatio="none">
      <path d="M0,30 C200,8 450,34 700,10 C900,-6 1050,22 1200,8 L1200,30 L0,30 Z" fill="var(--dark)"></path>
    </svg>
  </div>

  <div class="container footer-grid">
    <div class="footer-col">
      <h3>F&B Painting & Decorating</h3>
      <p class="footer-tagline">
        Professional domestic & commercial painting, decorating, and property repairs across the North West.
      </p>
      <p class="footer-copy">&copy; {new Date().getFullYear()} F&B Painting & Decorating Services. All rights reserved.</p>
    </div>

    <div class="footer-col">
      <h4>Contact Us</h4>
      <ul class="footer-list">
        <li>Phone: <a href={`tel:${siteInfo.phone}`}>{siteInfo.phone}</a></li>
        <li>Email: <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></li>
        <li>100% Free Quotes & Consultations</li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Areas Covered</h4>
      <ul class="footer-list">
        {siteInfo.coverage.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h4>Connect</h4>
      <ul class="footer-list">
        <li><a href={siteInfo.socials.nextdoor} target="_blank" rel="noopener noreferrer">Nextdoor</a></li>
        <li><a href={siteInfo.socials.myjobquote} target="_blank" rel="noopener noreferrer">MyJobQuote</a></li>
        <li><a href={siteInfo.socials.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
        <li><a href={siteInfo.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--dark);
    color: #e2e8f0;
    padding: 5rem 0 2rem;
    margin-top: 2.5rem;
    border-top: none;
  }

  .brush-edge-top {
    position: absolute;
    top: -20px;
    left: 0;
    width: 100%;
    height: 22px;
    line-height: 0;
    pointer-events: none;
  }

  .brush-edge-top svg {
    width: 100%;
    height: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 3rem;
  }

  .footer-col h3 {
    color: #ffffff;
    font-size: 1.6rem;
    margin-bottom: 0.75rem;
  }

  .footer-col h4 {
    color: #ffffff;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: #64748b;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .footer-list a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-list a:hover {
    color: var(--primary-light, #00c8ff);
  }
</style>
