---
import { siteInfo } from '../data/siteInfo.ts'
---

<footer>
  <div>
    <h3>Contact Us</h3>
    <p>Phone: <a href={`tel:${siteInfo.phone.replace(/\s+/g, '')}`}>{siteInfo.phone}</a></p>
    <p>Email: <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></p>
  </div>

  <div>
    <h3>Areas Covered</h3>
    <ul>
      {siteInfo.coverage.map((area) => (
        <li>{area}</li>
      ))}
    </ul>
  </div>

  <div>
    <h3>Follow Us</h3>
    <a href={siteInfo.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    <a href={siteInfo.socials.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
  </div>

  <div>
    <p>&copy; {new Date().getFullYear()} {siteInfo.name}. All rights reserved.</p>
  </div>
</footer>
