---
import { siteInfo } from '../data/siteInfo';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  message: string;
  buttonText?: string;
  class?: string;
  iconSize?: number;
}

const { 
  message, 
  buttonText = "WhatsApp Us for a Quote", 
  class: className = '',
  iconSize = 18
} = Astro.props;

const whatsappNumber = siteInfo.phone.replace(/^0/, '44').replace(/\s+/g, '');
const encodedMessage = encodeURIComponent(message);
---

<a 
  href={`https://wa.me/${whatsappNumber}?text=${encodedMessage}`} 
  target="_blank" 
  rel="noopener noreferrer" 
  class={`btn-whatsapp ${className}`}
>
  <WhatsAppIcon size={iconSize} />
  <span>{buttonText}</span>
</a>

<style>
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    align-self: flex-start;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: 6px;
    text-decoration: none !important;
    background-color: #0d3b2e; /* Deep, muted WhatsApp brand green */
    color: #ffffff !important;
    border: 1px solid #1a5744;
    gap: 0.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
  }

  .btn-whatsapp :global(svg) {
    color: #25D366; /* Authentic Meta green icon */
    flex-shrink: 0;
  }
  
  .btn-whatsapp:hover {
    background-color: #12523f;
    border-color: #25D366;
    transform: translateY(-1px);
  }

  /* Bottom CTA banner override */
  .btn-whatsapp.btn-large {
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    gap: 0.6rem;
  }
</style>
