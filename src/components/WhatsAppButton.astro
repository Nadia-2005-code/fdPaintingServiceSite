---
import { siteInfo } from '../data/siteInfo';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  message: string;
  buttonText?: string;
  class?: string;
  iconSize?: number;
}

const { 
  message, 
  buttonText = "WhatsApp Us for a Quote", 
  class: className = '',
  iconSize = 18
} = Astro.props;

const encodedMessage = encodeURIComponent(message);
---


<a 
  href={`https://wa.me/${siteInfo.whatsappRaw}?text=${encodedMessage}`} 
  target="_blank" 
  rel="noopener noreferrer" 
  class={`btn btn-whatsapp ${className}`}
>
  <WhatsAppIcon size={iconSize} />
  <span>{buttonText}</span>
</a>

<style>
  .btn-whatsapp {
    background-color: #0d3b2e; 
    color: #ffffff !important;
    border: 1px solid #1a5744;
    width: fit-content;
    align-self: flex-start;
  }

  .btn-whatsapp :global(svg) {
    color: #25D366; 
    flex-shrink: 0;
  }
  
  .btn-whatsapp:hover {
    background-color: #12523f;
    border-color: #25D366;
  }
</style>
