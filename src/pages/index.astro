---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import faisalVanImg from '../assets/Faisal-Van.jpg';
import NextDoorLogo from '../components/icons/NextDoorLogo.astro';
import MyJobQuoteIcon from '../components/icons/MyJobQuoteIcon.astro';
import { siteInfo } from '../data/siteInfo';
import TestimonialsSection from '../components/TestimonialsSection.astro';

const dialPhone = siteInfo.phone.replace(/\s+/g, '');
---

<BaseLayout
  title="F&B Painting & Decorating | Professional Decorators Wirral & Liverpool"
  description="High-finish interior & exterior painting, decorating, and property repairs across Wirral, Liverpool, Chester, and Ellesmere Port. Contact us for 100% free quotes."
>
  <!-- Single, Mobile-Optimized Hero Section -->
  <section class="main-section">
    <div class="container main-grid">
      <div class="main-copy">
        <span class="badge-location">Serving Wirral, Liverpool and Chester</span>
        <h1>Reliable Painting & Decorating Done Right</h1>
        <p class="main-subtitle">
          Quality interior and exterior finishes, wallpapering, and reliable property repairs.
          Prompt service, spotless clean-up, and zero-obligation pricing.
        </p>

        <div class="cta-group">
          <a href={`tel:${dialPhone}`} class="btn btn-primary">
            Call for a Free Quote
          </a>
          <a href="/services" class="btn btn-outline">
            Explore Our Services
          </a>
        </div>
      </div>

      <div class="main-media">
        <div class="image-frame">
        <Image
          src={faisalVanImg}
          alt="Owner standing proudly with the F&B painting and decorating van"
          widths={[360, 480, 720, 960, 1200]}
          sizes="(max-width: 640px) 340px, (max-width: 768px) 400px, 420px"
          width={420}
          height={420}
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="main-image"
        />
        </div>
      </div>
    </div>
  </section>

  <!-- Centered Trust Bar -->
  <section class="trust-bar">
    <div class="container trust-grid">
      <a
        href={siteInfo.socials.nextdoor}
        target="_blank"
        rel="noopener noreferrer"
        class="trust-card"
      >
        <NextDoorLogo class="trust-icon nd-icon" />
        <div class="trust-meta">
          <span class="stars">★★★★★</span>
          <span class="trust-label"><strong>5-Star Rated</strong> on Nextdoor</span>
        </div>
      </a>

      <a
        href={siteInfo.socials.myjobquote}
        target="_blank"
        rel="noopener noreferrer"
        class="trust-card"
      >
        <MyJobQuoteIcon size={26} />
        <div class="trust-meta">
          <span class="trust-tag">Verified Member</span>
          <span class="trust-label"><strong>Direct Profile</strong> on MyJobQuote</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Core Services Interactive Cards -->
  <section class="services-section">
    <div class="container">
      <div class="section-header">
        <h2>What We Do</h2>
        <p>Comprehensive domestic and commercial trade solutions tailored to your home.</p>
      </div>

      <div class="services-grid">
        <a href="/services#interior" class="service-card">
          <div class="service-card-content">
            <div class="service-number">01</div>
            <h3>Interior Painting</h3>
            <p>Feature walls, full rooms, woodwork, doors, and ceilings finished with meticulous prep work and dust protection.</p>
          </div>
          <span class="card-action">View Interior Services &rarr;</span>
        </a>

        <a href="/services#exterior" class="service-card">
          <div class="service-card-content">
            <div class="service-number">02</div>
            <h3>Exterior Decorating</h3>
            <p>Weather-proof masonry coatings, window frames, fascias, and exterior woodwork built to withstand the seasons.</p>
          </div>
          <span class="card-action">View Exterior Services &rarr;</span>
        </a>

        <a href="/services#repairs" class="service-card">
          <div class="service-card-content">
            <div class="service-number">03</div>
            <h3>Property Repairs</h3>
            <p>Plaster patching, caulking, minor wall repairs, and reliable turnkey maintenance for homeowners and local landlords.</p>
          </div>
          <span class="card-action">View Repair Services &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <TestimonialsSection />

  <!-- Why Choose F&B -->
  <section class="why-us-section">
    <div class="container why-grid">
      <div class="why-copy">
        <h2>Why Work with Faisal?</h2>
        <p>Hiring a decorator shouldn't come with stress, mess, or vague pricing. We treat every property with respect from day one.</p>
      </div>

      <div class="perks-list">
        <div class="perk-item">
          <h3>Spotless Clean-up</h3>
          <p>Every work area is fully protected with dust sheets and clean edge masking, left tidy at the end of each day.</p>
        </div>
        <div class="perk-item">
          <h3>Clear, Fixed Quotes</h3>
          <p>Zero hidden surprises or unexpected extra charges without prior agreement. All quotes valid for 14 days.</p>
        </div>
        <div class="perk-item">
          <h3>Reliable & Accountable</h3>
          <p>Prompt morning arrivals, direct phone communication, and personal accountability on every job.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Main Hero Section */
  .main-section {
    padding: 0.5rem 0 2rem;
    background-color: var(--surface);
  }

  .main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .main-section {
      padding: 4rem 0 3rem;
    }
    .main-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }

  .badge-location {
    display: inline-block;
    background-color: var(--bg-light);
    border: 1px solid var(--border);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .main-copy h1 {
    font-size: 2.35rem;
    line-height: 1.1;
    color: var(--dark);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .main-copy h1 {
      font-size: 3.5rem;
      margin-bottom: 1.25rem;
    }
  }

  .main-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.75rem;
    max-width: 600px;
  }

  @media (min-width: 768px) {
    .main-subtitle {
      font-size: 1.15rem;
      line-height: 1.6;
      margin-bottom: 2rem;
    }
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .cta-group {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }

  .image-frame {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.12);
    border: 4px solid #fff;
    background-color: #fff;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: 1/1;
  }

  @media (min-width: 768px) {
    .image-frame {
      max-width: none;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.16);
    }
  }

  .main-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  /* Centered Trust Section */
  .trust-bar {
    background-color: var(--bg-light);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .trust-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-items: center;
  }

  @media (min-width: 900px) {
    .trust-grid {
      flex-direction: row;
      gap: 6rem;
    }

    .trust-card:nth-child(1) {
      justify-self: end;
    }

    .trust-card:nth-child(2) {
      justify-self: center;
    }

    .trust-card:nth-child(3) {
      justify-self: start;
    }
  }

  .trust-card {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-main);
    transition: transform 0.15s ease;
  }

  a.trust-card:hover {
    transform: translateY(-1px);
  }

  .nd-icon {
    height: 22px;
    width: auto;
  }

  .trust-meta {
    display: flex;
    flex-direction: column;
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .stars {
    color: var(--accent);
    font-size: 1rem;
    letter-spacing: 1px;
  }

  .trust-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .commitment-pill {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    text-align: center;
  }

  .check-icon {
    color: var(--primary);
    font-weight: bold;
  }

  /* Services Preview Cards */
  .services-section {
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .services-section {
      padding: 5rem 0;
    }
  }

  .section-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 2.5rem;
  }

  @media (min-width: 768px) {
    .section-header {
      margin: 0 auto 3.5rem;
    }
  }

  .section-header h2 {
    font-size: 2.25rem;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .section-header h2 {
      font-size: 2.85rem;
    }
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  @media (min-width: 768px) {
    .section-header p {
      font-size: 1.15rem;
    }
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      gap: 2rem;
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 1.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  @media (min-width: 768px) {
    .service-card {
      padding: 2.25rem 2rem;
    }
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
    box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .service-number {
      font-size: 1.5rem;
    }
  }

  .service-card h3 {
    font-size: 1.5rem;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .service-card h3 {
      font-size: 1.75rem;
      margin-bottom: 0.75rem;
    }
  }

  .service-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .service-card p {
      font-size: 0.98rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
  }

  .card-action {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--primary);
    transition: transform 0.15s ease;
  }

  @media (min-width: 768px) {
    .card-action {
      font-size: 0.95rem;
    }
  }

  .service-card:hover .card-action {
    transform: translateX(4px);
  }

  /* Why Choose */
  .why-us-section {
    background-color: var(--bg-light);
    border-top: 1px solid var(--border);
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .why-us-section {
      padding: 5rem 0;
    }
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: 1fr 1.5fr;
      align-items: start;
      gap: 3.5rem;
    }
  }

  .why-copy h2 {
    font-size: 2.25rem;
    color: var(--dark);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .why-copy h2 {
      font-size: 2.85rem;
      margin-bottom: 1rem;
    }
  }

  .why-copy p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .why-copy p {
      font-size: 1.15rem;
      line-height: 1.6;
    }
  }

  .perks-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .perks-list {
      gap: 2rem;
    }
  }

  .perk-item h3 {
    font-size: 1.35rem;
    color: var(--dark);
    margin-bottom: 0.25rem;
  }

  @media (min-width: 768px) {
    .perk-item h3 {
      font-size: 1.5rem;
      margin-bottom: 0.35rem;
    }
  }

  .perk-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .perk-item p {
      line-height: 1.6;
    }
  }
</style>
