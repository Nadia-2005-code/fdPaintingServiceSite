---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { siteInfo } from '../data/siteInfo';

import interiorImg from '../assets/service-interior.jpg';
import exteriorImg from '../assets/service-exterior.jpg';
import repairsImg from '../assets/service-repairs.jpg';

const dialPhone = siteInfo.phone.replace(/\s+/g, '');
---

<BaseLayout
  title="Our Services | F&B Painting & Decorating"
  description="Explore our complete range of domestic and commercial decorating services across Wirral, Liverpool, and Chester. Free fixed quotes on all projects."
>
  <!-- Compact Page Header & Quick-Nav -->
  <section class="page-hero">
    <div class="container">
      <h1>Our Services</h1>
      <div class="quick-nav">
        <a href="#interior" class="nav-chip">Interior</a>
        <a href="#exterior" class="nav-chip">Exterior</a>
        <a href="#repairs" class="nav-chip">Repairs</a>
      </div>
    </div>
  </section>

  <!-- Alternating Services Rows -->
  <section class="services-list">
    <div class="container services-container">

      <!-- Service 01 -->
      <article id="interior" class="service-row">
        <div class="service-media">
          <Image
            src={interiorImg}
            alt="Before and after transformation of an interior staircase and hallway"
            width={600}
            height={600}
            quality="high"
            loading="eager"
            class="service-img"
          />
        </div>
        <div class="service-details">
          <span class="service-num">01</span>
          <h2>Interior Decorating</h2>
          <p class="lead-text">
            Transforming living spaces with sharp lines, thorough sanding, and smooth paint coverage tailored to your chosen palette.
          </p>
          <ul class="service-checklist">
            <li>Feature walls, whole rooms, and multi-story staircases</li>
            <li>Woodwork restoration: skirting boards, architraves, and doors</li>
            <li>Banister sanding, priming, and modern contrast coatings</li>
            <li>Full floor and furniture masking with spotless daily tidy-up</li>
          </ul>
          <div class="service-actions">
            <a href={`tel:${dialPhone}`} class="btn btn-primary">Get a Quote for Interior Work</a>
            <a href="/gallery" class="link-gallery">See more interior transformations &rarr;</a>
          </div>
        </div>
      </article>

      <!-- Service 02 -->
      <article id="exterior" class="service-row reverse">
        <div class="service-media">
          <Image
            src={exteriorImg}
            alt="Before and after restoration of a traditional timber sash window"
            width={600}
            height={600}
            quality="high"
            loading="eager"
            class="service-img"
          />
        </div>
        <div class="service-details">
          <span class="service-num">02</span>
          <h2>Exterior Decorating</h2>
          <p class="lead-text">
            Protecting your property against the British elements using flexible, trade-grade exterior paints and weatherproofing primers.
          </p>
          <ul class="service-checklist">
            <li>Sash window and timber frame repair, preparation, and painting</li>
            <li>Exterior cladding, soffits, fascias, and rain-gutter touch-ups</li>
            <li>Weatherproof masonry coatings for brick, render, and stone</li>
            <li>Rot treatment and sealing before any topcoat is applied</li>
          </ul>
          <div class="service-actions">
            <a href={`tel:${dialPhone}`} class="btn btn-primary">Get a Quote for Exterior Work</a>
            <a href="/gallery" class="link-gallery">See more exterior transformations &rarr;</a>
          </div>
        </div>
      </article>

      <!-- Service 03 -->
      <article id="repairs" class="service-row">
        <div class="service-media">
          <Image
            src={repairsImg}
            alt="Before and after ceiling gouge repair and plaster patching"
            width={600}
            height={600}
            quality="high"
            class="service-img"
          />
        </div>
        <div class="service-details">
          <span class="service-num">03</span>
          <h2>Property Maintenance & Repairs</h2>
          <p class="lead-text">
            Reliable minor repair work that ensures painted surfaces remain flat, stable, and long-lasting without requiring expensive separate contractors.
          </p>
          <ul class="service-checklist">
            <li>Plaster gouge patching, crack repair, and dry-lining blends</li>
            <li>Bathroom ceiling mould remediation and moisture-resistant sealing</li>
            <li>Precision silicone caulking along skirting boards and tile lines</li>
            <li>Turnkey rental repairs and end-of-tenancy refreshes for landlords</li>
          </ul>
          <div class="service-actions">
            <a href={`tel:${dialPhone}`} class="btn btn-primary">Request Repair Assistance</a>
            <a href="/gallery" class="link-gallery">See more repair transformations &rarr;</a>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- Bottom CTA Dual Button Strip -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <h2>Have a Project in Mind?</h2>
      <p>All quotes are completely free, clear, and fixed for 14 days with zero obligation.</p>
      <div class="cta-actions">
        <a href={`tel:${dialPhone}`} class="btn btn-primary btn-large">
          Call Now: {siteInfo.phone}
        </a>
        <a href={`mailto:${siteInfo.email}?subject=Quote%20Request`} class="btn btn-outline btn-large">
          Email Us a Photo for a Quote
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Compact Page Hero & Quick-Nav Chips */
    .page-hero {
      background-color: var(--surface);
      padding: 1.25rem 0 1rem;
      border-bottom: 1px solid var(--border);
      text-align: center;
    }

    .page-hero h1 {
      font-size: 1.85rem;
      line-height: 1.1;
      color: var(--dark);
      margin-bottom: 0.75rem;
    }

    .quick-nav {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }

    .nav-chip {
      display: inline-block;
      background-color: var(--bg-light);
      border: 1px solid var(--border);
      color: var(--primary);
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      text-decoration: none;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .nav-chip:hover {
      background-color: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    @media (min-width: 768px) {
      .page-hero {
        padding: 2rem 0;
      }
      .page-hero h1 {
        font-size: 2.75rem;
        margin-bottom: 1rem;
      }
      .nav-chip {
        font-size: 0.85rem;
        padding: 0.4rem 1.1rem;
      }
    }

    /* Alternating Rows & List */
    .services-list {
      padding: 1.25rem 0;
      background-color: var(--bg-light);
    }

    .services-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .service-row {
      scroll-margin-top: 80px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: center;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    @media (min-width: 768px) {
      .services-list {
        padding: 5rem 0;
      }
      .services-container {
        gap: 5rem;
      }
      .service-row {
        padding: 2rem;
        gap: 3rem;
      }
    }

    @media (min-width: 900px) {
      .service-row {
        grid-template-columns: 1fr 1.15fr;
        padding: 3rem;
        gap: 4rem;
      }

      .service-row.reverse {
        grid-template-columns: 1.15fr 1fr;
      }

      .service-row.reverse .service-media {
        order: 2;
      }

      .service-row.reverse .service-details {
        order: 1;
      }
    }

    /* Shortened, Controlled Media Frame */
    .service-media {
      border-radius: 8px;
      overflow: hidden;
      border: 4px solid #fff;
      background-color: #fff;
      width: 100%;
      max-width: 320px;
      max-height: 240px;
      justify-self: center;
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.05),
        0 3px 6px -2px rgba(18, 21, 26, 0.1),
        0 12px 24px -4px rgba(18, 21, 26, 0.18);
    }

    @media (min-width: 768px) {
      .service-media {
        max-width: 560px;
        max-height: none;
        border-width: 8px;
      }
    }

    .service-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    @media (min-width: 768px) {
      .service-img {
        height: auto;
        object-fit: initial;
      }
    }

    .service-num {
      font-family: var(--font-heading);
      color: var(--primary);
      font-size: 1.35rem;
      line-height: 1;
      display: inline-block;
      margin-bottom: 0.2rem;
    }

    .service-details h2 {
      font-size: 1.65rem;
      color: var(--dark);
      margin-bottom: 0.5rem;
      line-height: 1.1;
    }

    @media (min-width: 768px) {
      .service-num {
        font-size: 1.75rem;
      }
      .service-details h2 {
        font-size: 2.25rem;
        margin-bottom: 1rem;
      }
    }

    .lead-text {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.45;
      margin-bottom: 1rem;
    }

    @media (min-width: 768px) {
      .lead-text {
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }
    }

    .service-checklist {
      list-style: none;
      padding: 0;
      margin: 0 0 1.25rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .service-checklist li {
      position: relative;
      padding-left: 1.5rem;
      font-size: 0.88rem;
      color: var(--text-main);
      line-height: 1.35;
    }

    .service-checklist li::before {
      content: "✔";
      position: absolute;
      left: 0;
      color: var(--primary);
      font-weight: bold;
    }

    @media (min-width: 768px) {
      .service-checklist {
        margin-bottom: 2rem;
        gap: 0.75rem;
      }
      .service-checklist li {
        font-size: 0.98rem;
        padding-left: 1.75rem;
      }
    }

    .service-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      align-items: flex-start;
      width: 100%;
    }

    @media (min-width: 640px) {
      .service-actions {
        flex-direction: row;
        align-items: center;
        gap: 1.5rem;
        width: auto;
      }
    }

    .link-gallery {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--primary);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .link-gallery:hover {
      color: var(--primary-dark);
      text-decoration: underline;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      padding: 0.65rem 1.25rem;
      border-radius: 6px;
      text-decoration: none;
      transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
      text-align: center;
    }

    @media (max-width: 639px) {
      .service-actions .btn {
        width: 100%;
      }
    }

    @media (min-width: 768px) {
      .btn {
        font-size: 1.15rem;
        padding: 0.75rem 1.6rem;
      }
    }

    .btn-primary {
      background-color: var(--primary);
      color: #ffffff;
      border: 2px solid var(--primary);
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
      border-color: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-outline {
      background-color: transparent;
      color: var(--dark);
      border: 2px solid var(--dark);
    }

    .btn-outline:hover {
      background-color: var(--dark);
      color: #ffffff;
      transform: translateY(-1px);
    }

    /* CTA Banner */
    .cta-banner {
      background-color: var(--surface);
      padding: 2.5rem 0;
      border-top: 1px solid var(--border);
      text-align: center;
    }

    .cta-inner h2 {
      font-size: 1.85rem;
      color: var(--dark);
      margin-bottom: 0.4rem;
      line-height: 1.1;
    }

    .cta-inner p {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
    }

    .cta-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    @media (min-width: 640px) {
      .cta-actions {
        flex-direction: row;
        justify-content: center;
        gap: 1.25rem;
      }
    }

    @media (min-width: 768px) {
      .cta-banner {
        padding: 5rem 0;
      }
      .cta-inner h2 {
        font-size: 2.75rem;
      }
      .cta-inner p {
        font-size: 1.15rem;
        margin-bottom: 2rem;
      }
    }

    .btn-large {
      font-size: 1.1rem;
      padding: 0.75rem 1.5rem;
    }

    @media (min-width: 768px) {
      .btn-large {
        font-size: 1.25rem;
        padding: 0.85rem 2rem;
      }
    }
  </style>
</BaseLayout>
